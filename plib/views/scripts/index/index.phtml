                </label>
            </li>
            <li>
                <label>
                    <input type="checkbox" class="cfdns-modal__confirm">
                    <strong>Nameservers.</strong> I will update (or have updated) the nameservers at the registrar to point at Cloudflare for this domain — without that, the synced records won't be authoritative.
                </label>
            </li>
        </ul>
        <p class="cfdns-modal__note">Activation pushes records into Cloudflare immediately; the records only take effect once the registrar's nameservers point there and any old DNSSEC DS records have been cleared.</p>
        <div class="cfdns-modal__buttons">
            <button type="button" class="cfdns-modal__cancel">Cancel</button>
            <button type="button" class="cfdns-modal__proceed" disabled>Activate and sync</button>
        </div>
    </div>
</div>

<script type="text/javascript">
(function () {
    // --- API token field unlock -------------------------------------------
    // Select the checkbox by id, not name — Plesk renders a checkbox as a
    // hidden companion input plus the visible box, both sharing one name.
    var tokenToggle = document.getElementById('change_token');
    var tokenField = document.getElementById('api_token');
    if (tokenToggle && tokenField) {
        tokenToggle.addEventListener('change', function () {
            tokenField.disabled = !tokenToggle.checked;
            if (tokenToggle.checked) {
                tokenField.value = '';
                tokenField.focus();
            }
        });
    }

    // --- Per-domain + auto-enable toggles (instant, AJAX) -----------------
    var toggleDomainUrl = <?php echo json_encode($this->toggleDomainUrl); ?>;
    var toggleAutoenableUrl = <?php echo json_encode($this->toggleAutoenableUrl); ?>;
    var domainStatusUrl = <?php echo json_encode($this->domainStatusUrl); ?>;

    function post(url, data) {
        var token = document.getElementById('form_forgery_protection_token');
        data.forgery_protection_token = token ? token.value : '';
        var body = Object.keys(data).map(function (k) {
            return encodeURIComponent(k) + '=' + encodeURIComponent(data[k]);
        }).join('&');
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: body
        }).then(function (r) { return r.json(); });
    }

    function setStatus(cell, status) {
        cell.textContent = status.text;
        cell.className = 'cfdns-status cfdns-status-' + status['class'];
    }

    // Poll a domain's status while its background sync runs.
    function pollStatus(row) {
        var cell = row.querySelector('.cfdns-status');
        var domain = row.getAttribute('data-domain');
        var tries = 0;
        cell.textContent = 'Syncing…';
        cell.className = 'cfdns-status cfdns-status-muted';
        (function tick() {
            tries++;
            fetch(domainStatusUrl + '?domain=' + encodeURIComponent(domain), {
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (res && res.success && !res.pending) {
                    setStatus(cell, res.status);
                } else if (tries < 15) {
                    setTimeout(tick, 2000);
                } else {
                    setStatus(cell, (res && res.status) ? res.status
                        : { text: 'Enabled — sync status unknown', 'class': 'muted' });
                }
            })
            .catch(function () {
                if (tries < 15) { setTimeout(tick, 2000); }
            });
        })();
    }

    // Run the actual toggle AJAX after the (off) path or after the modal-confirmed (on) path.
    function fireToggle(row, checkbox, cell, on) {
        checkbox.disabled = true;
        cell.textContent = on ? 'Syncing…' : 'Updating…';
        cell.className = 'cfdns-status cfdns-status-muted';
        post(toggleDomainUrl, { domain: row.getAttribute('data-domain'), enabled: on ? '1' : '0' })
            .then(function (res) {
                if (!res || !res.success) {
                    throw new Error(res && res.message ? res.message : 'Request failed');
                }
                if (res.pending) {
                    pollStatus(row);
                } else {
                    setStatus(cell, res.status);
                }
            })
            .catch(function (err) {
                checkbox.checked = !on;
                setStatus(cell, { text: 'Error: ' + err.message, 'class': 'error' });
            })
            .then(function () { checkbox.disabled = false; });
    }

    // --- Activation confirmation modal ------------------------------------
    // Surfaces DNSSEC + registrar-NS prerequisites the operator must
    // acknowledge before a domain is activated. See ROADMAP.md (DNSSEC
    // awareness) for the eventual programmatic detection plan.
    var modal = document.getElementById('cfdns-activate-modal');
    function showActivationModal(row, checkbox, cell) {
        var domain = row.getAttribute('data-domain');
        modal.querySelector('.cfdns-modal__domain').textContent = domain;

        var confirms = modal.querySelectorAll('.cfdns-modal__confirm');
        var proceedBtn = modal.querySelector('.cfdns-modal__proceed');
        var cancelBtn = modal.querySelector('.cfdns-modal__cancel');

        // Reset state every time it opens.
        Array.prototype.forEach.call(confirms, function (cb) { cb.checked = false; });
        proceedBtn.disabled = true;

        function refreshProceed() {
            var allChecked = Array.prototype.every.call(confirms, function (cb) { return cb.checked; });
            proceedBtn.disabled = !allChecked;
        }
        function cleanup() {
            modal.setAttribute('data-open', '0');
            modal.setAttribute('aria-hidden', 'true');
            Array.prototype.forEach.call(confirms, function (cb) { cb.removeEventListener('change', refreshProceed); });
            proceedBtn.removeEventListener('click', onProceed);
            cancelBtn.removeEventListener('click', onCancel);
            document.removeEventListener('keydown', onKey);
        }
        function onProceed() {
            cleanup();
            fireToggle(row, checkbox, cell, true);
        }
        function onCancel() {
            cleanup();
            checkbox.checked = false; // revert; the user backed out
        }
        function onKey(e) {
            if (e.key === 'Escape') { onCancel(); }
        }

        Array.prototype.forEach.call(confirms, function (cb) { cb.addEventListener('change', refreshProceed); });
        proceedBtn.addEventListener('click', onProceed);
        cancelBtn.addEventListener('click', onCancel);
        document.addEventListener('keydown', onKey);

        modal.setAttribute('data-open', '1');
        modal.setAttribute('aria-hidden', 'false');
    }

    var rows = document.querySelectorAll('.cfdns-domains tr[data-domain]');
    Array.prototype.forEach.call(rows, function (row) {
        var checkbox = row.querySelector('.cfdns-domain-toggle');
        var cell = row.querySelector('.cfdns-status');

        checkbox.addEventListener('change', function () {
            var on = checkbox.checked;
            if (on) {
                // Activating: gate behind the migration-prerequisites modal.
                showActivationModal(row, checkbox, cell);
            } else {
                // Deactivating: instant, no gate.
                fireToggle(row, checkbox, cell, false);
            }
        });

        // A domain already mid-sync when the page loaded — keep polling.
        if (row.getAttribute('data-pending') === '1') {
            pollStatus(row);
        }
    });

    var autoToggle = document.getElementById('cfdns-autoenable-toggle');
    if (autoToggle) {
        autoToggle.addEventListener('change', function () {
            var on = autoToggle.checked;
            autoToggle.disabled = true;
            post(toggleAutoenableUrl, { enabled: on ? '1' : '0' })
                .then(function (res) {
                    if (!res || !res.success) { autoToggle.checked = !on; }
                })
                .catch(function () { autoToggle.checked = !on; })
                .then(function () { autoToggle.disabled = false; });
        });
    }
})();
</script>
