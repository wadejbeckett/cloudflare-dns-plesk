{
    "name": "noiz/cloudflare-dns-plesk",
    "description": "Non-destructive Cloudflare DNS sync for Plesk — preserves proxy state, comments, tags and page rules.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "keywords": ["cloudflare", "dns", "plesk", "sync"],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Noiz\\CloudflareDns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noiz\\CloudflareDns\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
