{
    "name": "noiz/cloudflare-dns-sync-plesk",
    "description": "Cloudflare DNS Sync — Plesk extension. Panel adapter over the panel-agnostic noiz/cloudflare-dns-sync-core.",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "keywords": ["cloudflare", "dns", "plesk", "sync"],
    "repositories": [
        { "type": "path", "url": "../../core" }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "noiz/cloudflare-dns-sync-core": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33"
    },
    "autoload": {
        "psr-4": {
            "Noiz\\CloudflareDns\\PleskDns\\": "plib/library/PleskDns/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noiz\\CloudflareDns\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
