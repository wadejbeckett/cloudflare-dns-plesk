<!-- Activation confirmation modal: shown before any domain activation so that
     the operator can't accidentally activate a DNSSEC-signed domain or one
     whose registrar nameservers haven't been pointed at Cloudflare. -->
<div id="cfdns-activate-modal" class="cfdns-modal" aria-hidden="true" role="dialog" aria-labelledby="cfdns-activate-title">
