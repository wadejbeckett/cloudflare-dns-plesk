        <p class="cfdns-modal__note">Activation pushes records into Cloudflare immediately; the records only take effect once the registrar's nameservers point there and any old DNSSEC DS records have been cleared.</p>
        <div class="cfdns-modal__buttons">
            <button type="button" class="cfdns-modal__cancel">Cancel</button>
            <button type="button" class="cfdns-modal__proceed" disabled>Activate and sync</button>
        </div>
    </div>
</div>

<script type="text/javascript">
(function () {
    // --- API token field unlock -------------------------------------------
    // Select the checkbox by id, not name — Plesk renders a checkbox as a
    // hidden companion input plus the visible box, both sharing one name.
    var tokenToggle = document.getElementById('change_token');
    var tokenField = document.getElementById('api_token');
    if (tokenToggle && tokenField) {
        tokenToggle.addEventListener('change', function () {
            tokenField.disabled = !tokenToggle.checked;
            if (tokenToggle.checked) {
                tokenField.value = '';
                tokenField.focus();
            }
        });
    }

    // --- Per-domain + auto-enable toggles (instant, AJAX) -----------------
    var toggleDomainUrl = <?php echo json_encode($this->toggleDomainUrl); ?>;
    var toggleAutoenableUrl = <?php echo json_encode($this->toggleAutoenableUrl); ?>;
    var domainStatusUrl = <?php echo json_encode($this->domainStatusUrl); ?>;
    var resyncDomainUrl = <?php echo json_encode($this->resyncDomainUrl); ?>;
    var resyncAllUrl = <?php echo json_encode($this->resyncAllUrl); ?>;

    function post(url, data) {
        var token = document.getElementById('form_forgery_protection_token');
        data.forgery_protection_token = token ? token.value : '';
        var body = Object.keys(data).map(function (k) {
            return encodeURIComponent(k) + '=' + encodeURIComponent(data[k]);
        }).join('&');
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: body
        }).then(function (r) { return r.json(); });
    }

    function setStatus(cell, status) {
        cell.textContent = status.text;
        cell.className = 'cfdns-status cfdns-status-' + status['class'];
    }

    // Poll a domain's status while its background sync runs. The toggle stays
    // disabled until polling lands a *real* final status — we never give up
    // mid-flight, so the operator can't be told a sync is finished when it
    // isn't. (A page reload always resets the cycle if something has gone
    // genuinely wrong server-side.)
    // onDone is called once polling resolves — used by per-row resync to
    // re-enable its refresh icon, by resync-all to track completion, etc.
    function pollStatus(row, checkbox, cell, onDone) {
        if (!cell) { cell = row.querySelector('.cfdns-status'); }
        var domain = row.getAttribute('data-domain');
        cell.textContent = 'Syncing… please wait';
        cell.className = 'cfdns-status cfdns-status-muted';
        function done() {
            if (checkbox) { checkbox.disabled = false; }
            if (typeof onDone === 'function') { onDone(); }
        }
        (function tick() {
            fetch(domainStatusUrl + '?domain=' + encodeURIComponent(domain), {
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (res && res.success && !res.pending) {
                    setStatus(cell, res.status);
                    done();
                } else {
                    // Still pending — keep polling. Toggle stays disabled.
                    setTimeout(tick, 2000);
                }
            })
            .catch(function () {
                // Transient network blip — keep trying.
                setTimeout(tick, 2000);
            });
        })();
    }

    // Run the actual toggle AJAX after the (off) path or after the modal-confirmed (on) path.
    // The toggle stays disabled until the *whole* flow completes — including
    // polling — so the operator can't interrupt a sync midway by clicking again.
    function fireToggle(row, checkbox, cell, on) {
        checkbox.disabled = true;
        cell.textContent = on ? 'Syncing… please wait' : 'Updating…';
        cell.className = 'cfdns-status cfdns-status-muted';
        post(toggleDomainUrl, { domain: row.getAttribute('data-domain'), enabled: on ? '1' : '0' })
            .then(function (res) {
                if (!res || !res.success) {
                    throw new Error(res && res.message ? res.message : 'Request failed');
                }
                if (res.pending) {
                    // pollStatus owns re-enabling the checkbox.
                    pollStatus(row, checkbox, cell);
                } else {
                    setStatus(cell, res.status);
                    checkbox.disabled = false;
                }
            })
            .catch(function (err) {
                checkbox.checked = !on;
                setStatus(cell, { text: 'Error: ' + err.message, 'class': 'error' });
                checkbox.disabled = false;
            });
    }

    // --- Activation confirmation modal ------------------------------------
    // Surfaces DNSSEC + registrar-NS prerequisites the operator must
    // acknowledge before a domain is activated. See ROADMAP.md (DNSSEC
    // awareness) for the eventual programmatic detection plan.
    var modal = document.getElementById('cfdns-activate-modal');
    function showActivationModal(row, checkbox, cell) {
        var domain = row.getAttribute('data-domain');
        modal.querySelector('.cfdns-modal__domain').textContent = domain;

        var confirms = modal.querySelectorAll('.cfdns-modal__confirm');
        var proceedBtn = modal.querySelector('.cfdns-modal__proceed');
        var cancelBtn = modal.querySelector('.cfdns-modal__cancel');

        // Reset state every time it opens.
        Array.prototype.forEach.call(confirms, function (cb) { cb.checked = false; });
        proceedBtn.disabled = true;

        function refreshProceed() {
            var allChecked = Array.prototype.every.call(confirms, function (cb) { return cb.checked; });
            proceedBtn.disabled = !allChecked;
        }
        function cleanup() {
            modal.setAttribute('data-open', '0');
            modal.setAttribute('aria-hidden', 'true');
            Array.prototype.forEach.call(confirms, function (cb) { cb.removeEventListener('change', refreshProceed); });
            proceedBtn.removeEventListener('click', onProceed);
            cancelBtn.removeEventListener('click', onCancel);
            document.removeEventListener('keydown', onKey);
        }
        function onProceed() {
            cleanup();
            fireToggle(row, checkbox, cell, true);
        }
        function onCancel() {
            cleanup();
            checkbox.checked = false; // revert; the user backed out
        }
        function onKey(e) {
            if (e.key === 'Escape') { onCancel(); }
        }

        Array.prototype.forEach.call(confirms, function (cb) { cb.addEventListener('change', refreshProceed); });
        proceedBtn.addEventListener('click', onProceed);
        cancelBtn.addEventListener('click', onCancel);
        document.addEventListener('keydown', onKey);

        modal.setAttribute('data-open', '1');
        modal.setAttribute('aria-hidden', 'false');
    }

    // Fire a one-off resync for an already-activated row. No modal — the
    // domain is already on the activation list, so DNSSEC/NS prerequisites
    // were acknowledged on the original activation. The resync icon stays
    // disabled until the poll lands a final status, so the operator can't
    // re-click mid-sync.
    function fireResync(row, checkbox, cell, resyncBtn) {
        if (checkbox) { checkbox.disabled = true; }
        if (resyncBtn) { resyncBtn.disabled = true; }
        cell.textContent = 'Resyncing… please wait';
        cell.className = 'cfdns-status cfdns-status-muted';
        post(resyncDomainUrl, { domain: row.getAttribute('data-domain') })
            .then(function (res) {
                if (!res || !res.success) {
                    throw new Error(res && res.message ? res.message : 'Resync failed');
                }
                pollStatus(row, checkbox, cell, function () {
                    if (resyncBtn) { resyncBtn.disabled = false; }
                });
            })
            .catch(function (err) {
                setStatus(cell, { text: 'Error: ' + err.message, 'class': 'error' });
                if (checkbox) { checkbox.disabled = false; }
                if (resyncBtn) { resyncBtn.disabled = false; }
            });
    }

    var rows = document.querySelectorAll('.cfdns-domains tr[data-domain]');
    Array.prototype.forEach.call(rows, function (row) {
        var checkbox = row.querySelector('.cfdns-domain-toggle');
        var cell = row.querySelector('.cfdns-status');
        var resyncBtn = row.querySelector('.cfdns-resync');

        checkbox.addEventListener('change', function () {
            var on = checkbox.checked;
            // Show the per-row resync icon only when the row is active.
            row.classList.toggle('cfdns-row-active', on);
            if (on) {
                // Activating: gate behind the migration-prerequisites modal.
                showActivationModal(row, checkbox, cell);
            } else {
                // Deactivating: instant, no gate.
                fireToggle(row, checkbox, cell, false);
            }
        });

        if (resyncBtn) {
            resyncBtn.addEventListener('click', function () {
                fireResync(row, checkbox, cell, resyncBtn);
            });
        }

        // A domain already mid-sync when the page loaded — keep polling and
        // hold the toggle locked until it resolves.
        if (row.getAttribute('data-pending') === '1') {
            checkbox.disabled = true;
            pollStatus(row, checkbox, cell);
        }
    });

    // "Resync all activated domains" button — fires one trigger per
    // activated domain on the server; each row then polls independently.
    // Button stays disabled until EVERY row's poll resolves, so the
    // operator can't double-fire while a previous batch is still draining.
    var resyncAllBtn = document.getElementById('cfdns-resync-all-btn');
    if (resyncAllBtn) {
        resyncAllBtn.addEventListener('click', function () {
            resyncAllBtn.disabled = true;
            var originalLabel = resyncAllBtn.textContent;
            resyncAllBtn.textContent = 'Triggering resync…';
            post(resyncAllUrl, {})
                .then(function (res) {
                    if (!res || !res.success) {
                        throw new Error(res && res.message ? res.message : 'Resync-all failed');
                    }
                    var domains = res.domains || [];
                    if (domains.length === 0) {
                        resyncAllBtn.textContent = originalLabel;
                        resyncAllBtn.disabled = false;
                        return;
                    }
                    resyncAllBtn.textContent = 'Resyncing ' + domains.length + ' domain(s)…';
                    var pending = domains.length;
                    function oneRowDone() {
                        pending--;
                        resyncAllBtn.textContent = 'Resyncing ' + pending + ' of ' + domains.length + '…';
                        if (pending <= 0) {
                            resyncAllBtn.textContent = originalLabel;
                            resyncAllBtn.disabled = false;
                        }
                    }
                    domains.forEach(function (domain) {
                        var row = document.querySelector(
                            '.cfdns-domains tr[data-domain="' + domain.replace(/"/g, '\\"') + '"]'
                        );
                        if (!row) { oneRowDone(); return; }
                        var checkbox = row.querySelector('.cfdns-domain-toggle');
                        var cell = row.querySelector('.cfdns-status');
                        var rowResyncBtn = row.querySelector('.cfdns-resync');
                        if (checkbox) { checkbox.disabled = true; }
                        if (rowResyncBtn) { rowResyncBtn.disabled = true; }
                        cell.textContent = 'Resyncing… please wait';
                        cell.className = 'cfdns-status cfdns-status-muted';
                        pollStatus(row, checkbox, cell, function () {
                            if (rowResyncBtn) { rowResyncBtn.disabled = false; }
                            oneRowDone();
                        });
                    });
                })
                .catch(function (err) {
                    alert('Resync all failed: ' + err.message);
                    resyncAllBtn.textContent = originalLabel;
                    resyncAllBtn.disabled = false;
                });
        });
    }

    var autoToggle = document.getElementById('cfdns-autoenable-toggle');
    if (autoToggle) {
        autoToggle.addEventListener('change', function () {
            var on = autoToggle.checked;
            autoToggle.disabled = true;
            post(toggleAutoenableUrl, { enabled: on ? '1' : '0' })
                .then(function (res) {
                    if (!res || !res.success) { autoToggle.checked = !on; }
                })
                .catch(function () { autoToggle.checked = !on; })
                .then(function () { autoToggle.disabled = false; });
        });
    }
})();
</script>
