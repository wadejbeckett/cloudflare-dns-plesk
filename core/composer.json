{
    "name": "noiz/cloudflare-dns-sync-core",
    "description": "Panel-agnostic Cloudflare DNS sync core — Cloudflare API client and non-destructive reconciliation engine. Shared by the Plesk, DirectAdmin and future panel adapters.",
    "type": "library",
    "version": "0.1.0",
    "license": "GPL-3.0-or-later",
    "keywords": ["cloudflare", "dns", "sync"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33"
    },
    "autoload": {
        "psr-4": {
            "Noiz\\CloudflareDns\\": "library/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noiz\\CloudflareDns\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
